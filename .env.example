KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private_key.pem
ANTHROPIC_API_KEY=
# Optional: complete YouTube playlist listings for the video index (video_index.py).
# Without it the public channel/playlist pages are read instead.
YOUTUBE_API_KEY=
# Public hosting (see README "Serving publicly").
# KALSHI_MAX_RPS=8              # shared outbound Kalshi request budget
# ENGINE_CHAT_PUBLIC=1          # let tunneled visitors use the engine chat
# ENGINE_CHAT_DAILY_LIMIT=20    # messages per visitor IP per day when public

# Week feed automation (server threads; the VPS runs with these on)
# FEED_AUTO_REVIEW=1                 # review finished games, rewrite team notebooks
# FEED_AUTO_GENERATE=1               # write each game's preview before kickoff
# FEED_AUTO_LEAD_HOURS=5             # how long before kickoff
# FEED_AUTO_AB=claude-sonnet-5-5,claude-opus-5-5   # A/B these models (omit: one live post, default model)
# FEED_AUTO_LIVE_MODEL=claude-opus-5-5             # publish this model's A/B version to the live feed
